generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @default(uuid())
  name      String
  email     String  @unique
  password  String
  avatarUrl String? @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]

  @@map("user")
}

model Session {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash")
  previousTokenHash String?   @unique @map("previous_token_hash")
  remember          Boolean
  expiresAt         DateTime  @map("expires_at")
  rotatedAt         DateTime? @map("rotated_at")
  revokedAt         DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id            Int     @id @default(autoincrement())
  userId        String  @map("user_id")
  username      String  @unique
  type          String?
  isPrivate     Boolean @default(false) @map("is_private")
  ratingScore   Float   @default(0) @map("rating_score")
  reviewRatings Boolean @default(false) @map("review_ratings")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  configuration          Configuration?
  profile                Profile?
  playerAttributes       PlayerAttributes?
  ratingsGiven           Rating[]          @relation("RatingRater")
  ratingsReceived        Rating[]          @relation("RatingRated")
  following              Follow[]          @relation("Following")
  followers              Follow[]          @relation("Followers")
  notificationsGenerated Notification[]    @relation("NotificationGenerator")
  notificationsReceived  Notification[]    @relation("NotificationReceiver")
  recentSearches         RecentSearch[]    @relation("RecentSearches")
  searchedBy             RecentSearch[]    @relation("SearchedBy")
  ratingRequestsSent     RatingRequest[]   @relation("RatingRequestsSent")
  ratingRequestsReceived RatingRequest[]   @relation("RatingRequestsReceived")
  posts                  Post[]
  postMentions           PostMention[]
  clubMembers            ClubMember[]      @relation("ClubMembers")
  clubMemberships        ClubMember[]      @relation("ClubMemberships")

  @@map("account")
}

model Configuration {
  accountId     Int     @id @map("account_id")
  theme         String  @default("dark")
  language      String  @default("pt")
  notifications Boolean @default(true)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("configuration")
}

model Profile {
  accountId       Int     @id @map("account_id")
  displayName     String? @map("display_name")
  showDisplayName Boolean @default(true) @map("show_display_name")
  bio             String?
  avatarColor     String? @map("avatar_color")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("profile")
}

// Só para contas Player. Os valores aceitos ficam em src/player/constants.js e também
// travados no banco por CHECK (ver a migration create_player_attributes).
model PlayerAttributes {
  accountId     Int     @id @map("account_id")
  preferredFoot String? @map("preferred_foot")
  position      String?
  category      String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("player_attributes")
}

model Follow {
  followerId Int       @map("follower_id")
  followedId Int       @map("followed_id")
  status     String
  createdAt  DateTime  @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")

  follower Account @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followed Account @relation("Followers", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId, status])
  @@index([followerId, status])
  @@map("follow")
}

model NotificationTemplate {
  id      Int     @id @default(autoincrement())
  title   String  @unique
  type    String
  message String
  link    String?

  notifications Notification[]

  @@map("notification_template")
}

model Notification {
  id                        Int       @id @default(autoincrement())
  userGeneratorNotification Int?      @map("user_generator_notification")
  userReceivesNotification  Int       @map("user_receives_notification")
  templateId                Int       @map("template_id")
  createdAt                 DateTime  @default(now()) @map("created_at")
  readAt                    DateTime? @map("read_at")

  generator Account?             @relation("NotificationGenerator", fields: [userGeneratorNotification], references: [id], onDelete: Cascade)
  receiver  Account              @relation("NotificationReceiver", fields: [userReceivesNotification], references: [id], onDelete: Cascade)
  template  NotificationTemplate @relation(fields: [templateId], references: [id])

  @@index([userReceivesNotification, createdAt])
  @@map("notification")
}

model RatingRequest {
  requesterId Int      @map("requester_id")
  scoutId     Int      @map("scout_id")
  isPrivate   Boolean  @map("is_private")
  createdAt   DateTime @default(now()) @map("created_at")

  requester Account @relation("RatingRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  scout     Account @relation("RatingRequestsReceived", fields: [scoutId], references: [id], onDelete: Cascade)

  @@id([requesterId, scoutId, isPrivate])
  @@index([scoutId])
  @@map("rating_request")
}

model Post {
  id          Int     @id @default(autoincrement())
  accountId   Int     @map("account_id")
  position    Int     @db.SmallInt
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  account  Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  photos   PostPhoto[]
  mentions PostMention[]

  @@unique([accountId, position])
  @@map("post")
}

model PostPhoto {
  id       Int    @id @default(autoincrement())
  postId   Int    @map("post_id")
  url      String
  position Int    @db.SmallInt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@map("post_photo")
}

model PostMention {
  postId    Int @map("post_id")
  accountId Int @map("account_id")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([postId, accountId])
  @@index([accountId])
  @@map("post_mention")
}

model ClubMember {
  clubId    Int       @map("club_id")
  memberId  Int       @map("member_id")
  status    String
  createdAt DateTime  @default(now()) @map("created_at")
  joinedAt  DateTime? @map("joined_at")

  club   Account @relation("ClubMembers", fields: [clubId], references: [id], onDelete: Cascade)
  member Account @relation("ClubMemberships", fields: [memberId], references: [id], onDelete: Cascade)

  @@id([clubId, memberId])
  @@index([memberId, status])
  @@map("club_member")
}

model RecentSearch {
  accountId         Int      @map("account_id")
  searchedAccountId Int      @map("searched_account_id")
  searchedAt        DateTime @default(now()) @map("searched_at")

  account         Account @relation("RecentSearches", fields: [accountId], references: [id], onDelete: Cascade)
  searchedAccount Account @relation("SearchedBy", fields: [searchedAccountId], references: [id], onDelete: Cascade)

  @@id([accountId, searchedAccountId])
  @@index([accountId, searchedAt])
  @@map("recent_search")
}

model Rating {
  id         Int     @id @default(autoincrement())
  raterId    Int     @map("rater_id")
  ratedId    Int     @map("rated_id")
  isPrivate  Boolean @default(false) @map("is_private")
  status     String  @default("published")
  technique  Int     @db.SmallInt
  tactics    Int     @db.SmallInt
  physical   Int     @db.SmallInt
  creativity Int     @db.SmallInt
  evolution  Int     @db.SmallInt

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  rater Account @relation("RatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  rated Account @relation("RatingRated", fields: [ratedId], references: [id], onDelete: Cascade)

  @@unique([raterId, ratedId, isPrivate])
  @@index([ratedId])
  @@index([ratedId, status])
  @@map("rating")
}
